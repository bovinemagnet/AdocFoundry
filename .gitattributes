# Windows batch files need CRLF line endings.
*.bat text eol=crlf

# Fixtures and snapshots are compared byte for byte, offsets included, so they are checked out
# exactly as committed (LF) on every platform, binaries untouched. Pages with CRLF endings, as
# Windows writes them, are built by the tests that need them
# (`spans_are_the_same_with_crlf_line_endings`).
tests/fixtures/** -text
crates/*/tests/snapshots/*.snap -text

# Generated, and compared byte for byte with what the generators write (`theme_keys.rs` in
# adoc-pdf and adoc-docx).
src/docs/modules/ROOT/partials/theme-keys.adoc -text
src/docs/modules/ROOT/partials/word-theme-keys.adoc -text

# The built-in New Antora Project templates are embedded as they are checked out and written
# into new projects, so they stay LF on every platform, as the pages they become are compared.
crates/adoc-engine/templates/** -text
