flowchart LR
    subgraph producers["Background producers"]
        idx["Indexing worker"]
        srch["Search worker"]
        watch["notify watcher"]
    end
    chan[("Channels")]
    idx --> chan
    srch --> chan
    watch --> chan
    chan -.->|set_waker wakes| task
    task["AppState pump task<br/>sleeps until next_due or woken"] -->|calls| pump["Engine::pump"]
    pump -.->|next_due| task
    chan --> pump
    pump -->|publishes EngineEvent<br/>over std::mpsc| app["AppState"]
    app -->|re-emits as GPUI events| wv["WorkspaceView"]
    app --> sev["SourceEditorView"]
    app --> sv["SearchView"]
    app --> mv["MirrorView"]
