---
source: crates/adocfoundry-cli/tests/audit.rs
expression: "stdout(&cli(&[\"audit\", FIXTURE, \"--format\",\n\"sarif\"])).replace(&format!(\"\\\"version\\\": \\\"{}\\\"\", env!(\"CARGO_PKG_VERSION\")),\n\"\\\"version\\\": \\\"[version]\\\"\")"
---
{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AdocFoundry",
          "version": "[version]",
          "informationUri": "https://github.com/bovinemagnet/AdocFoundry",
          "rules": [
            {
              "id": "adoc.antora.resolved-via-alias",
              "shortDescription": {
                "text": "An AdocFoundry diagnostic, reported as the editor reports it"
              }
            },
            {
              "id": "adoc.unresolved-xref-file",
              "shortDescription": {
                "text": "An AdocFoundry diagnostic, reported as the editor reports it"
              }
            },
            {
              "id": "quality.image.missing-alt",
              "shortDescription": {
                "text": "An image macro has no meaningful alternative text"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "quality.navigation.unlisted-page",
              "shortDescription": {
                "text": "A page is absent from every navigation tree of its component version"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "quality.page.missing-title",
              "shortDescription": {
                "text": "A page has no usable document title"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
